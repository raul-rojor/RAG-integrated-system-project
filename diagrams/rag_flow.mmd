%% Music Matcher — RAG integration flow (as implemented)
%% Two grounded retrievals:
%%   (A) local Taste Codebook grounds the NL -> user_prefs parse step
%%   (B) web_search grounds WHICH real, well-known songs are chosen (each cited); features are the model's estimate
%% The generated candidate set feeds the UNCHANGED deterministic scorer.
%% AI mode uses a fixed model (claude-haiku-4-5); every AI step degrades to the offline catalog path.

flowchart TD
    U["🎧 User free-text taste / situation<br/>'nostalgic, want to feel related to lyrically'"]

    subgraph PARSE["(1) Parse — Claude, grounded in the Taste Codebook (RAG)"]
        LLM1["Claude: NL situation → user_prefs<br/>messages.parse() / schema-validated"]
        RULES["Rule-based parser<br/>(offline fallback)"]
    end

    CODEBOOK[["📗 knowledge/taste_codebook.md<br/>valence–arousal · functional context ·<br/>setting cues · vibe glossary · examples<br/>(local, human-owned retrieval corpus)"]]

    PREFS["user_prefs dict<br/>{genre[], mood[], energy, ...}<br/>(1+ profiles)"]

    subgraph RAG["(2) Retrieve + propose candidates — Claude + web_search (RAG)"]
        WS["web_search (bounded: max_uses, timeout)<br/>runs BEFORE generation"]
        GEN["Claude picks well-known real songs<br/>(not royalty-free) + estimates features<br/>+ cites each; genre/mood reuse the<br/>listener's tags (vocabulary alignment)"]
    end

    subgraph DOCS["Retrieved documents (surfaced by web_search)"]
        ED[["Editorial lists &amp; 'best songs for X'<br/>→ well-known candidate discovery"]]
        VER[["Wikipedia / Genius / AllMusic / streaming<br/>→ confirm the song is real + cite it"]]
        META[["MusicBrainz / AllMusic<br/>→ genre, mood, year"]]
    end

    NORM["Guardrail: clamp features to range,<br/>require citation, dedupe<br/>(sanitize_candidates)"]

    subgraph RETRIEVE["Scorer = existing deterministic engine (UNCHANGED)"]
        SCORE["_score_core / recommend_songs<br/>human-owned weights, exact genre/mood match"]
    end

    LOCAL[("data/songs.csv<br/>local catalog<br/>(offline fallback)")]

    RANK["Rank candidates (best over profiles)"]

    subgraph EXPLAIN["(3) Explain — Claude"]
        LLM3["Claude: warm prose<br/>from real numeric reasons"]
        REASONS["Existing reasons list<br/>(offline fallback)"]
    end

    OUT["🎵 Ranked recommendations + sources<br/>CLI (src/main.py) · Streamlit (src/app.py)"]

    U --> LLM1
    CODEBOOK -. retrieved by .-> LLM1
    LLM1 -. "no key / error / refusal (⚠ notice)" .-> RULES
    LLM1 --> PREFS
    RULES --> PREFS

    PREFS --> WS
    WS --> GEN
    ED -. surfaced by .-> WS
    VER -. surfaced by .-> WS
    META -. surfaced by .-> WS
    GEN --> NORM

    GEN -. "no citable songs / error (⚠ notice)" .-> LOCAL
    LOCAL --> SCORE

    NORM --> SCORE
    SCORE --> RANK
    RANK --> LLM3
    LLM3 --> OUT
    LLM3 -. "error / refusal" .-> REASONS
    REASONS --> OUT

    classDef ai fill:#6C4AB6,stroke:#3d2a70,color:#fff;
    classDef det fill:#1F7A5A,stroke:#0f4433,color:#fff;
    classDef guard fill:#B54708,stroke:#6e2c05,color:#fff;
    classDef doc fill:#1663A6,stroke:#0c3a63,color:#fff;
    class LLM1,LLM3,WS,GEN ai;
    class SCORE,RULES,REASONS,NORM,LOCAL det;
    class NORM guard;
    class ED,VER,META,CODEBOOK doc;
